// I
module initialisers;

export struct Item {
    x: int;
    y: int;
    init (x: int, y: int) = ::(x + 1, y + 2);
    init = ::(10, 20);
}

export struct Wrapper { item: Item; z: int; }
export struct Factory { init (x: int) = x + 1; }

// First request this tuple's generated procedures from a local context.
proc private_tuple_user { var value: (Item, int); }
export struct TupleHolder { value: (Item, int); }
