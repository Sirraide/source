// I
module tuple_types;
import <typedef.h> as c;

export proc nested () = (1, (2, 3));
export proc sugared (value: (c::int_typedef, int)) -> (c::int_using, int) = value;

export struct Element {
    value: int;
    init = ::(42);
    delete {}
}

export struct Holder { value: (Element, int); }
export struct SugaredHolder { value: (c::int_using, int); }
