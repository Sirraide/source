// V %srcc --parse --verify %s
program test;

proc f(int...) {}
proc f(a: int...) {}
proc f(...int) {} // expected-error: Expected type
proc f(a...: int) {} // expected-error: Unexpected token in procedure argument list

proc f(var...) {}
proc f(a: var...) {}
proc f(...var) {} // expected-error: Expected type
proc f(a...: var) {} // expected-error: Unexpected token in procedure argument list

proc f($T...) {}
proc f(a: $T...) {}
proc f(...$T) {} // expected-error: Expected type
proc f(a...: $T) {} // expected-error: Unexpected token in procedure argument list

proc f(...) {} // expected-error: Expected type