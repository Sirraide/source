// V %srcc --sema --verify %s
program test;

var x1: int[0];
var x2: int[1];
var x3: int[100];
var x4: int[3 + 4];
var x5: int[5 + 7];
var x6: int[-1]; // expected-error: Array size cannot be negative (value: -1)
var x7: int[-2]; // expected-error: Array size cannot be negative (value: -2)
var x8: int[3-400]; // expected-error: Array size cannot be negative (value: -397)
var x9: int[4-3];
var x10: int[1000000000000000];
var x11: int[1000000000000000000000000000000000000000000000000]; // expected-error: Array size must fit into a signed 64-bit integer

noreturn[4](3); // expected-error: 'noreturn' is not allowed here
(var[4])(4); // expected-error: Type deduction is not allowed here

int[0](1); // expected-error: Too many elements in array initialiser for 'int[0]' (elements: 1)
int[1](1, 2); // expected-error: Too many elements in array initialiser for 'int[1]' (elements: 2)
int[4](1, 2, 3, 4, 5); // expected-error: Too many elements in array initialiser for 'int[4]' (elements: 5)

int[5](1);
i16[5](7);
i128[5](10);
var a1 = int[200](3);
var a2 = i16[200](3);

int[4](1, 2, 3, 4);
int[100](1, 2, 3, 4);

// Test that we differentiate between '(1, 2)' and '((1, 2))' properly;
// (see Sema::BuildConversionSequence()).
eval {
    var a1: int[2][2] = (1, 2);
    assert a1[0][0] == 1;
    assert a1[0][1] == 1;
    assert a1[1][0] == 2;
    assert a1[1][1] == 2;

    var a2: int[2][2] = ((1, 2));
    assert a2[0][0] == 1;
    assert a2[0][1] == 2;
    assert a2[1][0] == 1;
    assert a2[1][1] == 2;

    // '((1, 2),)' should be equivalent to '((1, 2))', even though the
    // AST is different: the former is a 1-tuple containing a 2-tuple,
    // the latter a parenthesised 2-tuple.
    var a3: int[2][2] = ((1, 2),);
    assert a3[0][0] == 1;
    assert a3[0][1] == 2;
    assert a3[1][0] == 1;
    assert a3[1][1] == 2;
}