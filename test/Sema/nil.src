// V %srcc --sema --verify %s
program test;

var x: int? = nil;
var x: void? = nil;
var x: i8[]? = nil;

var x: int^ = nil; // expected-error: Cannot convert expression of type 'nil' to 'int^'
var x: void^ = nil; // expected-error: Cannot convert expression of type 'nil' to 'void^'
var x: i8[]^^^^ = nil; // expected-error: Cannot convert expression of type 'nil' to 'i8[]^^^^'

var x: nil?; // expected-error: Element type of optional cannot be 'nil'
var x: nil? = nil; // expected-error: Element type of optional cannot be 'nil'

var x: int = nil; // expected-error: Cannot convert expression of type 'nil' to 'int'
var x: i8[] = nil; // expected-error: Cannot convert expression of type 'nil' to 'i8'
var x: void = nil; // expected-error: Cannot convert expression of type 'nil' to 'void'
var x: bool = nil; // expected-error: Cannot convert expression of type 'nil' to 'bool'
var x: i8 = nil; // expected-error: Cannot convert expression of type 'nil' to 'i8'
var x: int[4] = nil; // expected-error: Cannot convert expression of type 'nil' to 'int'
var x: type = nil; // expected-error: Cannot convert expression of type 'nil' to 'type'
var x: tree = nil; // expected-error: Cannot convert expression of type 'nil' to 'tree'