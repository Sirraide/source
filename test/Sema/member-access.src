// V %srcc --sema --verify %s
program test;

struct S {
    x: int;
    y: int; // expected-note: Conflicting declaration of field 'y' is here
    y: int; // expected-error: Redeclaration of 'y'
}

var a: S;
a.x = 1;
a.y = 2;
a.x = ""; // expected-error: Cannot assign value of type 'i8 val[]' to 'int'
a.z = 3; // expected-error: Struct 'S' has no member named 'z'

struct Nested {
    a: S;
    b: int;
}

var b: Nested;
b.a.x = 1;
b.a.y = 2;
b.a.y = b.a.x;
b.a.x = ""; // expected-error: Cannot assign value of type 'i8 val[]' to 'int'
b.a.z = 3; // expected-error: Struct 'S' has no member named 'z'
b.b = 4;
b.b.b = 5; // expected-error: Cannot perform member access on type 'int'
