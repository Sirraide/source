// V %srcc --sema --verify %s
program test;

struct s {
    x: int;
}

proc q = s(42);

eval {
    var a: s = (1);
    with a { x = 4; }
    assert a.x == 4;
}

eval with s(2) {
    assert x == 2;
    x = 3;
    assert x == 3;
}

eval with q() do assert x == 42;
eval with q() do assert x == 44; // expected-error: Assertion failed: 'x == 44'

eval with i64 {
    assert bits == 64;
    assert bytes == 8;
}

struct s2 {
    x: int;
    y: int;
}

proc f(in a: s2) = with a { x + y }
#assert f(s2(1, 2)) == 3;

proc f2(with in s2) = x + y;
#assert f2(s2(1, 2)) == 3;

proc f3(with x: int) = x; // expected-warning: 'with' has no effect as type 'int' has no members
proc f4(with x: void) = x; // expected-warning: 'with' has no effect as type 'void' has no members
proc f5(with t: type) = bytes;
#assert f5(i8) == 1;

proc f6 (with s2^) = x - y;
eval {
    var x: s2 = (4, 3);
    assert f6(&x) == 1;
}

proc f7 {
    proc a (with s2?) {}
    proc b (with s2?) = x - y;
}

eval {
    var x: s2 = (3, 4);
    var y: s2^ = &x;
    assert with y { x + y } == 7;
}