// V %srcc --sema --verify %s
program test;

proc direct_capture (int outer) { // expected-note 2: Variable declared here
    struct Direct {
        int value;
        init = ::(outer,); // expected-error: Variable 'outer' cannot be captured inside 'init'
    }
    struct Templated {
        int value;
        init ($T value) = ::(outer + value as int,); // expected-error: Variable 'outer' cannot be captured inside 'init'
    }
    Templated value = (1,);
}

proc nested_capture (int outer) { // expected-note: Variable declared here
    struct Nested {
        int value;
        init {
            int own = 1;
            proc helper () -> int = own + outer; // expected-error: Variable 'outer' cannot be captured inside 'init'
            return ::(helper(),);
        }
    }
}

// Referencing an enclosing closure also captures its environment.
proc closure_capture (int outer) {
    struct ViaClosure {
        int value;
        init = ::(closure(),); // expected-error: Procedure 'closure' cannot be referenced inside 'init' because it captures enclosing variables
    }
    proc closure () -> int = outer; // expected-note: Procedure declared here
}

proc indirect_closure_capture (int outer) {
    proc wrapper () -> int = closure(); // expected-note: Procedure declared here
    struct ViaWrapper {
        int value;
        init = ::(wrapper(),); // expected-error: Procedure 'wrapper' cannot be referenced inside 'init' because it captures enclosing variables
    }
    proc closure () -> int = outer;
}

proc copy_capture (int outer) { // expected-note: Variable declared here
    struct Copy {
        int value;
        copy = ::(outer,); // expected-error: Variable 'outer' cannot be captured inside 'copy'
    }
}

proc nested_copy_capture (int outer) { // expected-note: Variable declared here
    struct Copy {
        int value;
        copy {
            proc helper () -> int = outer; // expected-error: Variable 'outer' cannot be captured inside 'copy'
            return ::(helper(),);
        };
    }
}

proc delete_capture (int outer) { // expected-note: Variable declared here
    struct Delete {
        delete { int value = outer; } // expected-error: Variable 'outer' cannot be captured inside 'delete'
    }
}

proc nested_delete_capture (int outer) { // expected-note: Variable declared here
    struct Delete {
        delete {
            proc helper () -> int = outer; // expected-error: Variable 'outer' cannot be captured inside 'delete'
            helper();
        }
    }
}

proc closure_delete_capture (int outer) {
    struct Delete { delete { closure(); } } // expected-error: Procedure 'closure' cannot be referenced inside 'delete' because it captures enclosing variables
    proc closure () -> int = outer; // expected-note: Procedure declared here
}

proc closure_copy_capture (int outer) {
    struct Copy { int value; copy = ::(closure(),); } // expected-error: Procedure 'closure' cannot be referenced inside 'copy' because it captures enclosing variables
    proc closure () -> int = outer; // expected-note: Procedure declared here
}

proc template_closure_capture (int outer) {
    struct ViaTemplate {
        int value;
        init = ::(closure(1),); // expected-error: Procedure 'closure' cannot be referenced inside 'init' because it captures enclosing variables
    }
    proc closure ($T value) -> int = outer + value as int; // expected-note: Procedure declared here
}

// A recursive sibling reference can precede discovery of the capture.
proc recursive_closure_capture (int outer) {
    proc first (int n) -> int {
        if n != 0 { return second(n - 1); }
        return outer;
    }
    proc second (int n) -> int = first(n); // expected-note: Procedure declared here
    struct ViaCycle { int value; init = ::(second(0),); } // expected-error: Procedure 'second' cannot be referenced inside 'init' because it captures enclosing variables
}
