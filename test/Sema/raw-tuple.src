// V %srcc --sema --verify %s
program test;

struct Pair { int x; int y; }

Pair explicit = Pair::(1, 2);
Pair inferred = ::(3, 4);
int scalar = int::(42);
int defaulted = ::();
int[2] array = int[2]::(1, 2);
(int, int) tuple = (int, int)::(1, 2);

proc pair() -> Pair = ::(5, 6);
proc take(Pair p) {}
take(Pair::(1, 2));

var unknown = ::(1, 2); // expected-error: Type of raw tuple cannot be inferred
var args = (*Pair::(1, 2),);
var named = (**Pair::(1, 2),);
var parens = (*(Pair::(1, 2)),);

proc two(int a, int b) {} // expected-note: Callee declared here
two((int, int)::(1, 2)); // expected-error: Procedure 'two' expects 2 arguments, got 1
type ty = ::(int, int); // expected-error: Cannot initialise 'type' from '(type, type)'

var deduced = var::(); // expected-error: Type deduction is not allowed here
take(::(1, 2)); // expected-error: Type of raw tuple cannot be inferred
int invalid = int::(1, 2); // expected-error: Cannot initialise 'int' from '(int, int)'
var types = (int, int)::(1, 2);
