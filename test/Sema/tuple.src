// V %srcc --sema --verify %s
program test;

proc f() = (1,);

struct s {
    x: int;
    y: i8;
}

var x = ();
var a = (1, 2, 3);
a[0] = 4;
a[1] = 5;
a[2] = 6;

var j1: int = ();
var j2: int = (1);
var j3: int = (1,);
var j4: int = (1, 2); // expected-error: Cannot initialise 'int' from '(int, int)'

var x: i8 = ();
var x: i8 = (128);
var x: i8 = (128 as i8,);

var s1: s = ();
var s2: s = (1); // expected-error: Cannot initialise 's' from '(int)'
var s3: s = (1,); // expected-error: Cannot initialise 's' from '(int)'
var s4: s = (1, 2);

var x: int[4] = (1);
var x: int[4] = (1,);
var x: int[4] = (1, 2);
var x: int[4] = (1, 2);
var x: int[4] = (1, 2, 3);
var x: int[4] = (1, 2, 3, 4);
var x: int[4] = (1, 2, 3, 4, 5); // expected-error: Too many elements in array initialiser for 'int[4]' (elements: 5)

var x: s[3] = ();
var x: s[3] = (1); // expected-error: Cannot initialise 's' from '(int)'
var x: s[3] = (1, 2); // expected-error: Cannot initialise 's' from '(int)'
var x: s[3] = (s(1, 2));
var x: s[3] = ((1, 2));
var x: s[3] = ((1, 2), 1); // expected-error: Cannot initialise 's' from '(int)'
var x: s[3] = ((1, 2), 1, 2); // expected-error: Cannot initialise 's' from '(int)'
var x: s[3] = (s(1, 2), s(1, 2));
var x: s[3] = ((1, 2), (1, 2));

var x: int[2] = (((1, 2))); // expected-error: Cannot convert expression of type '(int, int)' to 'int'

var x: int = (1);
var x: int = (1,);
var x: int = ((1,));
var x: int = ((1,),);
var x: int = ((1),);

var x: int = f();
var x: int = (f());
var x: int = (f(),);
var x: int = ((f(),));
var x: int = ((f(),),);
var x: int = ((((f(),),)));
var x: int = ((((f(),),)),);

proc f1 {
    var x = (1, 1, 1);
    x[1 + 1] = 1;
    x[1 + 2] = 1; // expected-error: Tuple index 3 is out of bounds for 3-element tuple (int, int, int)
    x[1 - 2] = 1; // expected-error: Tuple index -1 is out of bounds for 3-element tuple (int, int, int)
    x[-2] = 1; // expected-error: Tuple index -2 is out of bounds for 3-element tuple (int, int, int)
}

var x: (int, int, int) = (1, 2, 3);
var x: (int) = 1;
var x: (int) = (1,);
var x: (int,) = 1;
var x: (int,) = (1);
var x: (int,) = (1,);
var x: ((int,)) = (1,);
var x: (((((int))))) = (1);

var x: (var,); // expected-error: Type deduction is not allowed here
var x: (noreturn,); // expected-error: 'noreturn' is not allowed here
var x: (incomplete,);

struct incomplete {

}

eval {
    var x = (a: 1, b: 2, c: 3);
    var y = x.a + x.b + x.c;
    assert y == 6;
}

eval {
    var x = (a: 1, b: 2, c: 3);
    assert (with x do a + b + c) == 6;
}
