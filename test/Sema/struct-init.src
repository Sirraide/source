// V %srcc --sema --verify %s
program test;

struct DefaultInit {
    a: int; // expected-note 2: In initialiser for field 'a'
    b: int; // expected-note: In initialiser for field 'b'
}

{
var x: DefaultInit;
var y: DefaultInit = DefaultInit(1, 2);
var z = DefaultInit(1, 2);
var w = DefaultInit();
}

{
var x = DefaultInit(1); // expected-error: Cannot initialise 'DefaultInit' from '(int)'
var y = 1;
var z = "";
}

{
var x = DefaultInit(1, "foo"); // expected-error: Cannot convert expression of type 'i8 val[]' to 'int'
var y = DefaultInit("foo", 1); // expected-error: Cannot convert expression of type 'i8 val[]' to 'int'
var y = DefaultInit("foo", "foo"); // expected-error: Cannot convert expression of type 'i8 val[]' to 'int'
}

{
struct Nested {
    x: DefaultInit;
    y: DefaultInit;
}

var x = Nested();
var y = Nested(DefaultInit(1, 2), DefaultInit(3, 4));
}

{
struct NestedLiteralInit1 { x: int; }
struct NestedLiteralInit2 { x: NestedLiteralInit1; }
var x = NestedLiteralInit2(NestedLiteralInit1(1));
var y = NestedLiteralInit2(1);
}

{
struct NestedLiteralInit1 { x: int; }
struct NestedLiteralInit2 {
    x: NestedLiteralInit1;
    y: NestedLiteralInit1;
}

var x = NestedLiteralInit2(NestedLiteralInit1(1), 1);
var y = NestedLiteralInit2(1, NestedLiteralInit1(1));
var z = NestedLiteralInit2(1, 1);
}

{
struct x { a: i64; }
struct y {
    a: i64; // expected-note: In initialiser for field 'a'
    b: i64;
    c: i64;
}

var a = x(1);
var d: y = a; // expected-error: Cannot convert expression of type 'x' to 'i64'
}
