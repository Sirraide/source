// V %srcc --sema --verify --target x86_64-unknown-linux %s
program test;

s1 x;
s1? y;
#assert s1.bytes == 16;
#assert s1[4].bytes == 64;
struct s1 {
    int x;
    int y;
}

struct s2 { s2 x; } // expected-error (Cyclic semantic dependency) expected-note (While computing layout of 's2')
struct s3 { s4 x; } // expected-error (Cyclic semantic dependency) expected-note (While computing layout of 's3')
struct s4 { s3 x; } // expected-note: While computing layout of 's4'
struct s5 { s5? x; } // expected-error (Cyclic semantic dependency) expected-note (While computing layout of 's5')
struct s6 { s6[5] x; } // expected-error (Cyclic semantic dependency) expected-note (While computing layout of 's6')
struct s7 { int[s7.bytes] x; } // expected-error (Cyclic semantic dependency) expected-note (While computing layout of 's7') expected-error (Querying property of incomplete type 's7')

struct s {
   int x;
}

proc f (with s?) {}

// Parameter declarations do not force layout before declarations are registered.
struct foo { bar e;  }
proc a(foo x) {}
struct bar { int x; }
