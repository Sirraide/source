// V %srcc --sema --verify --target x86_64-unknown-linux %s
program test;

var x: s1;
var y: s1?;
#assert s1.bytes == 16;
#assert s1[4].bytes == 64;
struct s1 {
    x: int;
    y: int;
}

struct s2 { x: s2; } // expected-error (Cyclic semantic dependency) expected-note (While computing layout of 's2')
struct s3 { x: s4; } // expected-error (Cyclic semantic dependency) expected-note (While computing layout of 's3')
struct s4 { x: s3; } // expected-note: While computing layout of 's4'
struct s5 { x: s5?; } // expected-error (Cyclic semantic dependency) expected-note (While computing layout of 's5')
struct s6 { x: s6[5]; } // expected-error (Cyclic semantic dependency) expected-note (While computing layout of 's6')
struct s7 { x: int[s7.bytes]; } // expected-error (Cyclic semantic dependency) expected-note (While computing layout of 's7') expected-error (Querying property of incomplete type 's7')

struct s {
   x: int;
}

proc f (with s?) {}

// Parameter declarations do not force layout before declarations are registered.
struct foo { e: bar;  }
proc a(x: foo) {}
struct bar { x: int; }
