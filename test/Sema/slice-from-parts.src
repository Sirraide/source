// V %srcc --sema --verify %s
program test;

var i: int;
var j: i8;
var pi: int^ = &i;
var pj: i8^ = &j;

var s1: int[] = (pi, i);
var s2: int[] = (&i, i);
var s3: i8[] = (pj, 1);
var s4: i8[] = (&j, 1);

var s5: int[] = (pi, pi); // expected-error: Cannot convert expression of type 'int^' to 'int'
var s6: int[] = (&i, &j); // expected-error: Cannot convert expression of type 'int^' to 'int'
var s7: i8[] = (pj, &i); // expected-error: Cannot convert expression of type 'i8^' to 'i8'
var s8: i8[] = (&j, pi); // expected-error: Cannot convert expression of type 'i8^' to 'i8'