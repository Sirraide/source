// V %srcc --sema --verify %s
program test;

proc same extern; // expected-note 2 (Conflicting declaration of procedure 'same' is here)
proc same extern; // expected-error: Procedure 'same' redefined
proc same extern; // expected-error: Procedure 'same' redefined

proc intent (in x: int)  extern; // expected-note: Conflicting declaration of procedure 'intent' is here
proc intent (out x: int) extern; // expected-error: Cannot overload procedure 'intent' on parameter intent
proc intent (out x: i32) extern; // Ok.

proc ret extern -> i32; // expected-note: Conflicting declaration of procedure 'ret' is here
proc ret extern -> int; // expected-error: Cannot overload procedure 'ret' on return type
proc ret (int) extern -> int; // expected-note: Conflicting declaration of procedure 'ret' is here
proc ret (int) extern -> i32; // expected-error: Cannot overload procedure 'ret' on return type

proc ret2 extern -> int; // expected-note: Conflicting declaration of procedure 'ret2' is here
proc ret2 extern -> int val; // expected-error ('val' is only allowed in variable declarations or pointer types) expected-error (Procedure 'ret2' redefined)

proc va varargs extern; // expected-note: Conflicting declaration of procedure 'va' is here
proc va (int...) extern; // expected-error: 'varargs' procedure 'va' redefined as variadic

proc va2 (int...) extern; // expected-note: Conflicting declaration of procedure 'va2' is here
proc va2 varargs extern; // expected-error: Variadic procedure 'va2' redefined as 'varargs'

// TODO: Reduction operator '[+]'.
proc sum(args: $T) -> T.elem {
    var res: (T.elem);
    for arg in args do res += arg;
    return res;
}

// Ok: 'int' arguments will call the first overload, 'i32' parameters the second.
proc va3 (a: int...) = sum(a);
proc va3 (a: i32...) = sum(a) * 2;
#assert va3(1, 2, 3) == 6;
#assert va3(i32(1), i32(2), i32(3)) == 12;

proc va4(int...) extern; // expected-note: Conflicting declaration of procedure 'va4' is here
proc va4(int...) extern; // expected-error: Procedure 'va4' redefined
