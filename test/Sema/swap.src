// V %srcc --sema --verify %s
program test;

var a: int;
var b: int;
a >< a;
a >< b;
(if true then a else b) >< (if true then a else b);
1 >< 2; // expected-error: Invalid target for assignment
a >< 1; // expected-error: Invalid target for assignment
1 >< a; // expected-error: Invalid target for assignment
var x: int = b >< a; // expected-error: Cannot convert expression of type 'void' to 'int'

var sa: int[];
var sb: int[];
sa >< sb;
a >< sa; // expected-error: Cannot swap 'int' with 'int[]'
sa >< a; // expected-error: Cannot swap 'int[]' with 'int'
