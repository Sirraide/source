// V %srcc --sema --verify %s
program test;

// Previously, this would check that we don’t crash when trying to
// point to a parameter before a procedure’s ParamDecls are created.
// We now do this earlier, so this is no longer a problem.

callee(""); // expected-error: Cannot convert expression of type 'i8 val[]' to 'int'

proc callee (int a) {} // expected-note 2: In argument to parameter 'a'

callee(""); // expected-error: Cannot convert expression of type 'i8 val[]' to 'int'
