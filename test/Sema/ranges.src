// V %srcc --sema --verify %s
program test;

proc f1 {
    var a: range<int>;
    var b: range<int> = 1..=2;
    var c = 1..=2;

    proc pf (x: range<int>) = 3..=4;

    var d: range<int[]>; // expected-error: Range element type must be an integer, but was 'int[]'
    var e: range<int^>; // expected-error: Range element type must be an integer, but was 'int^'
}

proc f2 {
    var a: range<int>;
    var b: range<int> = 1..<2;
    var c = 1..<2;

    proc pf (x: range<int>) = 3..<4;

    var d: range<int[]>; // expected-error: Range element type must be an integer, but was 'int[]'
    var e: range<int^>; // expected-error: Range element type must be an integer, but was 'int^'
}

var x: range<i13>;
