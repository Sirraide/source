// V %srcc --sema --verify %s
program test;

struct S {
    x: int;
}

struct T {
    x: int;
}

proc S::double (inout s: S) { s.x *= 2; }
proc S::triple (with inout s: This) { x *= 3; }
proc S::quadruple (inout this) { x *= 4; }

proc T::double (inout this) { x *= 2; }

eval {
    var s = S(2);
    s.double();
    assert s.x == 4;
    s.triple();
    assert s.x == 12;
    s.quadruple();
    assert s.x == 48;
}

eval {
    var t = T(2);
    t.double();
    assert t.x == 4;
}

proc int::double (this) = this * 2;
eval {
    var x: int = 4.double();
    assert x == 8;
}

proc int::load(x: This^) = ^x;
proc int::store(x: This^, y: int) { ^x = y };
eval {
    var x: int;
    var px: int^ = &x;
    var ppx: int^^ = &px;

    px.store(42);
    assert px.load() == 42;

    ppx.store(43);
    assert ppx.load() == 43;
}

proc (int^)::foo(this) {}; // expected-error: Pointer type 'int^' cannot be used as an associated type
proc (int^)::bar(this, x: int) {}; // expected-error: Pointer type 'int^' cannot be used as an associated type
proc (int?)::baz(this, x: int) {}; // expected-error: Optional type 'int?' cannot be used as an associated type
proc (int?^?^??)::quux(this, x: int) {}; // expected-error: Optional type 'int?^?^??' cannot be used as an associated type
proc (int?^?^?^)::asdf(this, x: int) {}; // expected-error: Pointer type 'int?^?^?^' cannot be used as an associated type
