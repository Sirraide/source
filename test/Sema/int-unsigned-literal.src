// V %srcc --sema --verify %s
program test;

// Permit treating integer literals as unsigned.
var a: i8 = -128;
var a: i8 = 128;
var a: i8 = 255;
var a: i16 = -32768;
var a: i16 = 65535;

var a: i8 = -129; // expected-error: Type 'i8' cannot represent the value '-129'
var a: i16 = -32769; // expected-error: Type 'i16' cannot represent the value '-32769'
var a: i8 = 256; // expected-error: Cannot convert expression of type 'int' to 'i8'
var a: i16 = 65536; // expected-error: Cannot convert expression of type 'int' to 'i16'

var zero: i8 = 0;
var zero: i8 = -0;