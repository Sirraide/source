// V %srcc --sema --verify %s
program test;

proc f(int...) {}
proc f(int, int...) {}
proc f(int, int..., int) {} // expected-error: Only the last parameter can be variadic
proc f(int, int..., int...) {} // expected-error: Only the last parameter can be variadic

proc f1 (out int...) {} // expected-error: Variadic parameter cannot have intent 'out'
proc f2 (inout int...) {} // expected-error: Variadic parameter cannot have intent 'inout'
proc f3 (out $T...) {} // expected-error: Variadic parameter cannot have intent 'out'
proc f4 (inout $T...) {} // expected-error: Variadic parameter cannot have intent 'inout'
proc f5 ($T, out T...) {} // expected-error: Variadic parameter cannot have intent 'out'
proc f6 ($T, inout T...) {} // expected-error: Variadic parameter cannot have intent 'inout'
proc f7 (out var...) {} // expected-error: Variadic parameter cannot have intent 'out'
proc f7 (inout var...) {} // expected-error: Variadic parameter cannot have intent 'inout'

proc variadic_varargs1(int...) varargs {} // expected-error: Variadic function cannot be 'varargs'
proc variadic_varargs2($T...) varargs {} // expected-error: Variadic function cannot be 'varargs'
proc variadic_varargs3(var...) varargs {} // expected-error: Variadic function cannot be 'varargs'

proc g (x: int ...) {}

g();
g(1);
g(1, 2);
g(1, 2, 3);

proc h (x: $T ...) {} // expected-note 2: Callee declared here

h();
h(1);
h(1, 2);
h(1, 2 as i32, 3); // expected-error: Template argument substitution failed
h(1 as i32, 2 as i32, 3); // expected-error: Template argument substitution failed
h(1 as i32, 2 as i32, 3 as i32);

proc j (y: $T, x: $T ...) {} // expected-note 3: Callee declared here

j(42);
j(42, 1);
j(42, 1 as i32); // expected-error: Template argument substitution failed
j(42 as i32, 1); // expected-error: Template argument substitution failed
j(42, 1, 2 as i32, 3); // expected-error: Template argument substitution failed

proc k (y: $T, x: T...) {}

k(42 as i64);
k(42 as i64, 1);
k(42 as i64, 1 as i32);
k(42 as i32, 1);
k(42 as i64, 1, 2 as i32, 3);

proc l (x: var ...) {}

l();
l(1);
l(1, 2);
l(1, 2);
l(1, "");
l(1, "");
