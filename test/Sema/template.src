// V %srcc --sema --verify %s
program test;

proc add(a: $T, b: T) = a + b; // expected-note (In argument to parameter 'b') expected-note 2 (Callee declared here)
proc add2(a: T, b: $T) = a + b;
proc add3(a: $T, b: $T) = a + b; // expected-note: Callee declared here
proc add4(a: $T, b: $U) = a + b; // expected-error: Invalid operation: '+' between 'int' and 'bool'

add(1, 2);
add2(1, 2);
add3(1, 2);
add4(1, 2);

add(1); // expected-error: Procedure 'add' expects 2 arguments, got 1
add(1, true); // expected-error: Cannot convert expression of type 'bool' to 'int'
add3(1, true); // expected-error: Template argument substitution failed
add4(1, true);

proc v(a: var, b: var) = a + b;
v(1 as i64, 2 as i32);
v(1 as i32, 2 as i64);