// V %srcc --sema --verify %s
program test;

struct S {
    b: i8;
    c: i16;
    d: i32;
    e: i64;
    a: int;
    z: i8;
}

var a: S;
var b: S;
var c: S2;

struct S2 {
    a: S;
    b: S;
}

var d: S2;

struct Invalid1 {
    x: int;
    y: int;
    q: void;

    // FIXME: Should say that it requires an initialiser.
    z: var; // expected-error: Type deduction is not allowed here
    b: Undefined; // expected-error: Unknown symbol 'Undefined'
}

struct Empty {}
struct ZeroSized {
    a: void;
    b: void;
}

struct Recursive { // expected-error (Cyclic semantic dependency) expected-note (While computing layout of 'Recursive')
    r: Recursive;
}

struct MutuallyRecursive1 { // expected-error (Cyclic semantic dependency) expected-note (While computing layout of 'MutuallyRecursive1')
    r: MutuallyRecursive2;
}

struct MutuallyRecursive2 { // expected-note: While computing layout of 'MutuallyRecursive2'
    r: MutuallyRecursive1;
}
