// V %srcc --sema --verify %s
program test;

proc constant ($x: int) = x; // expected-note 2 (In argument to parameter 'x') expected-note 2 (Callee declared here)
proc invalid_runtime (x: int) { constant(x); } // expected-error: Argument to constant parameter 'x' is not a compile-time constant
var global = 1;
constant(global); // expected-error: Argument to constant parameter 'x' is not a compile-time constant

proc modifiers (in val $x: int) = x; // expected-warning ('in' is redundant on a compile-time parameter) expected-warning ('val' is redundant on a compile-time parameter)
#assert modifiers(2) == 2;
proc wrong_out (out $x: int) {} // expected-error: Compile-time parameters cannot have 'out' intent
proc wrong_inout (inout $x: int) {} // expected-error: Compile-time parameters cannot have 'inout' intent

proc immutable ($x: int) { x = 2; } // expected-error: Invalid target for assignment
immutable(1);
proc address ($x: int) { var pointer = &x; } // expected-error: Cannot take address of non-lvalue
address(1);

proc f ($t: type, value: t) -> t = value; // expected-note (In argument to parameter 'value') expected-note (Callee declared here)
f(int, true); // expected-error: Cannot convert expression of type 'bool' to 'int'
proc bad_type ($t: int, value: t) {} // expected-error ('t' does not name a type) expected-note (Declared here) expected-note (In argument to parameter 'value') expected-note (Callee declared here)
bad_type(1, 2); // expected-error: Cannot convert expression of type 'int' to 'void'
proc forward_reference (value: int[n], $n: int) {} // expected-error (Unknown symbol 'n') expected-note (In argument to parameter 'value') expected-note (Callee declared here)
forward_reference((1, 2), 2); // expected-error: Cannot initialise 'void' from '(int, int)'

proc strict (exact $x: i128) = x; // expected-note (In argument to parameter 'x') expected-note (Callee declared here)
strict(1); // expected-error: Argument does not match parameter type 'i128'
proc constrained ($n: int) -> int where n > 0 { return n; } // expected-note: 'where' clause evaluated to 'false'
constrained(0); // expected-error: Constraints of 'constrained' not satisfied

proc ambiguous ($x: int) = x;
proc ambiguous ($x: int) = x;
ambiguous(1); // expected-error: Overload resolution failed in call to 'ambiguous'

proc invalid_pointer ($pointer: int^) {} // expected-note (In argument to parameter 'pointer') expected-note (Callee declared here)
proc dangling -> int^ { var x = 1; return &x; }
invalid_pointer(dangling()); // expected-error: Argument to constant parameter 'pointer' references out-of-scope stack memory

proc duplicate ($x: int, x: int) {} // expected-error (Redeclaration of 'x') expected-note (Conflicting declaration of compile-time parameter 'x' is here)
duplicate(1, 2);

proc in_only (in $x: int) = x; // expected-warning: 'in' is redundant on a compile-time parameter
proc val_only (val $x: int) = x; // expected-warning: 'val' is redundant on a compile-time parameter
#assert in_only(1) == 1;
#assert val_only(2) == 2;
struct BadPointer { pointer: int^; }
proc invalid_nested_pointer ($value: BadPointer) {} // expected-note (In argument to parameter 'value') expected-note (Callee declared here)
invalid_nested_pointer(BadPointer(dangling())); // expected-error: Argument to constant parameter 'value' references out-of-scope stack memory

proc invalid_array ($pointers: int^[2]) {} // expected-note (In argument to parameter 'pointers') expected-note (Callee declared here)
invalid_array((dangling(), dangling())); // expected-error: Argument to constant parameter 'pointers' references out-of-scope stack memory

struct ImmutablePair { value: int; }
proc immutable_field ($p: ImmutablePair) { p.value = 3; } // expected-error: Cannot assign to immutable value
immutable_field(ImmutablePair(1));
proc immutable_array ($values: int[2]) { values[0] = 3; } // expected-error: Cannot assign to immutable value
immutable_array((1, 2));
proc immutable_tuple ($values: (int, int)) { (values)[0] = 3; } // expected-error: Cannot assign to immutable value
immutable_tuple((1, 2));
proc immutable_with (with $p: ImmutablePair) { value = 3; } // expected-error: Cannot assign to immutable value
immutable_with(ImmutablePair(1));

// Errors preparing an unsuccessful constant probe must not escape the candidate.
proc optional_fallback ($value: int) = 1;
proc optional_fallback (value: int?) = 2;
optional_fallback(nil as int?);
proc dynamic_optional (value: int?) = optional_fallback(value);

// An invalid procedure body remains a hard error during a probe.
proc invalid_body -> int { return missing_symbol; } // expected-error: Unknown symbol 'missing_symbol'
constant(invalid_body());
