// V %srcc --sema --verify %s
program test;

struct s { x: int; }
struct t { x: bool; }

proc ** (in a: s, in b: s) = s(a.x ** b.x);
proc * (in a: s, in b: s) = s(a.x * b.x);
proc / (in a: s, in b: s) = s(a.x / b.x);
proc % (in a: s, in b: s) = s(a.x % b.x);
proc *~ (in a: s, in b: s) = s(a.x *~ b.x);
proc :/ (in a: s, in b: s) = s(a.x :/ b.x);
proc :% (in a: s, in b: s) = s(a.x :% b.x);
proc + (in a: s, in b: s) = s(a.x + b.x);
proc +~ (in a: s, in b: s) = s(a.x +~ b.x);
proc - (in a: s, in b: s) = s(a.x - b.x);
proc -~ (in a: s, in b: s) = s(a.x -~ b.x);
proc << (in a: s, in b: s) = s(a.x << b.x);
proc <<< (in a: s, in b: s) = s(a.x <<< b.x);
proc >> (in a: s, in b: s) = s(a.x >> b.x);
proc >>> (in a: s, in b: s) = s(a.x >>> b.x);
proc & (in a: s, in b: s) = s(a.x & b.x);
proc | (in a: s, in b: s) = s(a.x | b.x);
proc < (in a: s, in b: s) = t(a.x < b.x);
proc <= (in a: s, in b: s) = t(a.x <= b.x);
proc > (in a: s, in b: s) = t(a.x > b.x);
proc >= (in a: s, in b: s) = t(a.x >= b.x);
proc <: (in a: s, in b: s) = t(a.x <: b.x);
proc <=: (in a: s, in b: s) = t(a.x <=: b.x);
proc :> (in a: s, in b: s) = t(a.x :> b.x);
proc :>= (in a: s, in b: s) = t(a.x :>= b.x);
proc == (in a: s, in b: s) = t(a.x == b.x);
proc != (in a: s, in b: s) = t(a.x != b.x);
proc and (in a: t, in b: t) = t(a.x and b.x);
proc or (in a: t, in b: t) = t(a.x or b.x);
proc xor (in a: t, in b: t) = t(a.x xor b.x);
proc += (inout a: s, in b: s) = s(a.x += b.x);
proc -= (inout a: s, in b: s) = s(a.x -= b.x);
proc *= (inout a: s, in b: s) = s(a.x *= b.x);
proc +~= (inout a: s, in b: s) = s(a.x +~= b.x);
proc -~= (inout a: s, in b: s) = s(a.x -~= b.x);
proc *~= (inout a: s, in b: s) = s(a.x *~= b.x);
proc **= (inout a: s, in b: s) = s(a.x **= b.x);
proc /= (inout a: s, in b: s) = s(a.x /= b.x);
proc %= (inout a: s, in b: s) = s(a.x %= b.x);
proc <<= (inout a: s, in b: s) = s(a.x <<= b.x);
proc <<<= (inout a: s, in b: s) = s(a.x <<<= b.x);
proc >>= (inout a: s, in b: s) = s(a.x >>= b.x);
proc >>>= (inout a: s, in b: s) = s(a.x >>>= b.x);

// ============================================
proc ~ (a: s) = s(~a.x);
proc + (a: s) = s(+a.x);
proc - (a: s) = s(-a.x);

proc ..< (in a: s, in b: s) = a.x ..< b.x;
proc ..= (in a: s, in b: s) = a.x ..= b.x;

proc not (a: t) = t(not a.x);

proc [] (a: s) = a.x;
proc () (inout a: s) = a.x;
proc ++ (inout a: s) = ++a.x;
proc -- (inout a: s) = --a.x;
proc ^ (inout a: s) = a.x;
proc in (a: s, x: int) = t(a.x == x);
proc as (inout a: s) -> int = a.x;
proc as (inout a: s) -> i32 = a.x as i32;

var s1 = s(42);
var s2 = s(2);
var t1 = t(true);
var t2 = t(false);

assert (s1 ** s2).x == (42 ** 2);
assert (s1 * s2).x == (42 * 2);
assert (s1 / s2).x == (42 / 2);
assert (s1 % s2).x == (42 % 2);
assert (s1 *~ s2).x == (42 *~ 2);
assert (s1 :/ s2).x == (42 :/ 2);
assert (s1 :% s2).x == (42 :% 2);
assert (s1 + s2).x == (42 + 2);
assert (s1 +~ s2).x == (42 +~ 2);
assert (s1 - s2).x == (42 - 2);
assert (s1 -~ s2).x == (42 -~ 2);
assert (s1 << s2).x == (42 << 2);
assert (s1 <<< s2).x == (42 <<< 2);
assert (s1 >> s2).x == (42 >> 2);
assert (s1 >>> s2).x == (42 >>> 2);
assert (s1 & s2).x == (42 & 2);
assert (s1 | s2).x == (42 | 2);
assert (s1 < s2).x == (42 < 2);
assert (s1 <= s2).x == (42 <= 2);
assert (s1 > s2).x == (42 > 2);
assert (s1 >= s2).x == (42 >= 2);
assert (s1 <: s2).x == (42 <: 2);
assert (s1 <=: s2).x == (42 <=: 2);
assert (s1 :> s2).x == (42 :> 2);
assert (s1 :>= s2).x == (42 :>= 2);
assert (s1 == s2).x == (42 == 2);
assert (s1 != s2).x == (42 != 2);

assert (t1 and t2).x == (true and false);
assert (t1 or t2).x == (true or false);
assert (t1 xor t2).x == (true xor false);

assert { var v = s1; v += s2; v.x; } == { var v = 42; v += 2; };
assert { var v = s1; v -= s2; v.x; } == { var v = 42; v -= 2; };
assert { var v = s1; v *= s2; v.x; } == { var v = 42; v *= 2; };
assert { var v = s1; v +~= s2; v.x; } == { var v = 42; v +~= 2; };
assert { var v = s1; v -~= s2; v.x; } == { var v = 42; v -~= 2; };
assert { var v = s1; v *~= s2; v.x; } == { var v = 42; v *~= 2; };
assert { var v = s1; v **= s2; v.x; } == { var v = 42; v **= 2; };
assert { var v = s1; v /= s2; v.x; } == { var v = 42; v /= 2; };
assert { var v = s1; v %= s2; v.x; } == { var v = 42; v %= 2; };
assert { var v = s1; v <<= s2; v.x; } == { var v = 42; v <<= 2; };
assert { var v = s1; v <<<= s2; v.x; } == { var v = 42; v <<<= 2; };
assert { var v = s1; v >>= s2; v.x; } == { var v = 42; v >>= 2; };
assert { var v = s1; v >>>= s2; v.x; } == { var v = 42; v >>>= 2; };

assert ~s1.x == ~42;
assert +s1.x == +42;
assert -s1.x == -42;

// expected-no-diagnostics
