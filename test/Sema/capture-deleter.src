// V %srcc --sema --verify %s
program test;

proc f (x: int) extern;

proc f1 (x: int) { // expected-note: Variable declared here
    struct C {
        delete { f(x); } // expected-error: Variable 'x' cannot be captured inside 'delete'
    }
}

proc f2 (y: int) {
    struct C {
        delete {
            proc g(x: int) {
                proc h {
                    f(x); // Ok.
                }
            }
        }
    }
}