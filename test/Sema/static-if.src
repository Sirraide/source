// V %srcc --sema --verify %s
program test;

#if true {} #else {}
#if false {} #else {}
#if true {}
#if false {}
#if true {} #else { 4 = 5; }
#if false { 4 = 5; } #else {}

var x: int = #if true 1 #else "foobar";
var y: int = #if false "foobar" #else 1;
var z: int = #if true 1;

#if false {} #else { 4 = 5; } // expected-error: Invalid target for assignment
#if true { 4 = 5; } #else {} // expected-error: Invalid target for assignment

var w: int = #if false 1; // expected-error: Cannot convert expression of type 'void' to 'int'
