// V %srcc --sema --verify %s
program test;

struct Pair {
    x: int;
    y: int;
    init (x: int, y: int) = ::(x, y); // expected-note 3: Callee declared here
}

var valid: Pair = (1, 2);
var raw: Pair = ::(3, 4);
var missing: Pair; // expected-error: Procedure 'init' expects 2 arguments, got 0
var arity = Pair(1); // expected-error: Procedure 'init' expects 2 arguments, got 1
var names = Pair(z: 1, y: 2); // expected-error: Procedure 'init' has no parameter named 'z'

struct BadTuple {
    x: int;
    y: int;
    init (x: int, y: int) = (x, y); // expected-error (Cannot invoke an initialiser of 'BadTuple' inside its initialiser) expected-note (Enclosing initialiser declared here)
}

struct BadReturn {
    x: int;
    init (x: int) { return (x,); } // expected-error (Cannot invoke an initialiser of 'BadReturn' inside its initialiser) expected-note (Enclosing initialiser declared here)
}

struct Recursive {
    x: int;
    init = Recursive(1); // expected-error (Cannot invoke an initialiser of 'Recursive' inside its initialiser) expected-note (Enclosing initialiser declared here)
    init (x: int) = ::(x,);
}

struct NestedRecursion {
    x: int;
    init (x: int) { // expected-note: Enclosing initialiser declared here
        proc nested = NestedRecursion(1); // expected-error: Cannot invoke an initialiser of 'NestedRecursion' inside its initialiser
        return ::(x,);
    }
}

struct CopyInit {
    x: int;
    init (other: This) = ::(other.x,); // expected-error: An initialiser cannot take a single argument of its own type; use 'copy' instead
}

struct TemplateInit {
    x: int;
    init (x: $T) = ::(x,);
}

struct Factory {
    x: int;
    init (x: int) = x + 1;
}

var incompatible: Factory = (1,); // expected-error: Initialiser for 'Factory' returns 'int', which cannot initialise 'Factory'
var also_incompatible: Factory = Factory(2); // expected-error: Initialiser for 'Factory' returns 'int', which cannot initialise 'Factory'
var factory = Factory(3);

struct ImplicitRecursion {
    x: int;
    init (x: int) { // expected-note: Enclosing initialiser declared here
        var value: ImplicitRecursion = (x,); // expected-error: Cannot invoke an initialiser of 'ImplicitRecursion' inside its initialiser
        return ::(x,);
    }
}

struct DefaultRecursion {
    x: int;
    init { // expected-note: Enclosing initialiser declared here
        var value: DefaultRecursion; // expected-error: Cannot invoke an initialiser of 'DefaultRecursion' inside its initialiser
        return ::(0,);
    }
}

struct InferredOrder {
    x: int;
    init = ::(0,);
    init (x: int) = ::(x,);
}

struct ForwardBody {
    x: int;
    init (x: int) = ::(x,);
    init = ForwardResult(1);
}

struct ForwardResult {
    x: int;
    init (x: int) = ::(x,);
}

struct SingleVar {
    init (x: var) = x;
}

struct Ambiguous {
    x: int;
    init (x: i8) = ::(x as int,);
    init (x: i16) = ::(x as int,);
}

var ambiguous = Ambiguous(1); // expected-error: Overload resolution failed in call to 'init'

struct ConversionCycle {
    x: int;
    init (x: This, y: int) = ::(y,); // expected-note 2 (Callee declared here) expected-note (In argument to parameter 'x')
}

var cycle = ConversionCycle(1, 2); // expected-error: Procedure 'init' expects 2 arguments, got 1

struct MutuallyRecursiveA { init = MutuallyRecursiveB(); } // expected-note 2: While translating body of 'init'
struct MutuallyRecursiveB { init = MutuallyRecursiveA(); } // expected-error: Cyclic semantic dependency

struct DefaultFactory { init = 42; }
var invalid_default: DefaultFactory; // expected-error: Initialiser for 'DefaultFactory' returns 'int', which cannot initialise 'DefaultFactory'

struct FactoryField { field: DefaultFactory; tag: int; }
var invalid_field: FactoryField; // expected-error: Type 'FactoryField' requires a non-empty initialiser

struct TemplateRecursion {
    value: int;
    init (value: $T) = TemplateRecursion(value); // expected-error (Cannot invoke an initialiser of 'TemplateRecursion' inside its initialiser) expected-note (Enclosing initialiser declared here)
}

var template_recursion = TemplateRecursion(1);

// An uninstantiated initialiser template does not translate its body.
struct DeferredTemplate {
    init (value: $T) = unknown_name;
}

struct InoutInitialiser {
    value: int;
    init (inout a: int, inout b: int) = ::(a + b,);
}

var invalid_intents: InoutInitialiser = (1, 2); // expected-error 2: Cannot bind this expression to an inout parameter.

struct NestedIntentFailure { value: InoutInitialiser; tag: int; }
var nested_intents: NestedIntentFailure = ::( (1, 2), 3 ); // expected-error 2: Cannot bind this expression to an inout parameter.
var array_intents: InoutInitialiser[2] = ((1, 2), (3, 4)); // expected-error 4: Cannot bind this expression to an inout parameter.

// Warnings from a body translated during overload resolution must be retained.
var warning = WarningInitialiser(true);
struct WarningInitialiser {
    value: bool;
    init (value: bool) {
        if value = true {} // expected-warning: Assignment in condition. Did you mean to write '=='?
        return ::(value,);
    }
}

// Argument conversion can cycle without re-entering a declaration/body request.
struct ArgumentCycleA {
    value: int;
    init (value: ArgumentCycleB) = ::(value.value,); // expected-note (In argument to parameter 'value') expected-note (Callee declared here)
}

struct ArgumentCycleB {
    value: int;
    init (value: ArgumentCycleA) = ::(value.value,); // expected-note (In argument to parameter 'value') expected-note (Callee declared here)
}

var argument_cycle = ArgumentCycleA(1); // expected-error: Recursive initialiser argument conversion for 'ArgumentCycleA'

// Noreturn arguments convert to the target type without selecting a factory,
// irrespective of the factory's declared result type.
proc never_returns extern -> noreturn;
struct NoreturnFactory { init (value: int) = value; }
proc factory_noreturn () -> NoreturnFactory = NoreturnFactory(never_returns());
proc builtin_noreturn () -> int = int(never_returns());

// A body error must be reported even when it is encountered only while
// querying default-initialisability; a failed request must retain that failure.
struct InvalidDefault {
    value: int;
    init = unknown_default_value; // expected-error: Unknown symbol 'unknown_default_value'
}

struct InvalidDefaultField { value: InvalidDefault; }
var warning_again = WarningInitialiser(true);
