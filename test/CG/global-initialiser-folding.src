// R[//L] %srcc -fshort-filenames --llvm --target x86_64-unknown-linux %s
module folded_globals;
import <cstdio> as libc;

proc pure -> int {
    var value = 2;
    value = value + 3;
    return value;
}

export var folded = pure();
export var state = 0;
proc impure -> int {
    state += 1;
    return 9;
}

export var runtime_value = impure();
export var ffi = libc::puts("runtime only");
export var narrow: i9 = -2 as i9;
export var optional: int? = 42;
export var range_value = 1..<4;
export var array: int[2] = (5, 6);
struct Padded { a: i8; b: int; }
export var padded = Padded(1, 2);
export var null_pointer: int^? = nil;

// Pointer relocations retain runtime initialisation.
export var pointer = "text".data;

