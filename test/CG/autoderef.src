// R %srcc --ir --target x86_64-unknown-linux -foverflow-checks=false %s
program test;

struct s { x: int; }

proc sink(x: int) extern;

var a: s = (1);
var p1 = &a;
var p2 = &p1;
var p3 = &p2;
sink(a.x + p1.x + p2.x + p3.x);

