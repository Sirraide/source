// R %srcc -fshort-filenames --ir --target x86_64-unknown-linux %s
program test;

proc only ($x: int) = x;
proc mixed (left: int, $offset: int, right: int) = left + offset + right;
proc computed -> int = 7;
proc caller (value: int) = mixed(value, computed(), 3);
proc named (value: int) = mixed(right: value, offset: 9, left: 2);
proc typed ($t: type, value: t) -> t = value;
proc typed_caller (value: int) = typed(int, value);

var one = only(1);
var two = only(2);
var again = only(1 + 0);
struct Constructed { value: int; init ($n: int, value: int) = ::(n + value); }
proc initialise (value: int) -> Constructed = Constructed(4, value);

proc c_varargs ($tag: int, value: int) varargs -> int = value;
proc variadic_caller (value: int) = c_varargs(3, value, 8, 9);
struct VariadicFactory { value: int; init ($tag: int, value: int) varargs = ::(value); }
proc factory (value: int) = VariadicFactory(4, value, 8, 9);
var implicit: VariadicFactory = (5, 6, 7, 8);

