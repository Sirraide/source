// R      %srcc --ir --target x86_64-unknown-linux %s
// R[//L] %srcc --llvm --target x86_64-unknown-linux %s
program test;

struct x { a: i64; }

var a = x(1);
var b = a;

struct y { a: i64; b: i64; c: i64; }

var c = y(1, 2, 3);
var d = c;

// * @a = private 8, align 8
// + @b = private 8, align 8
// + @c = private 24, align 8
// + @d = private 24, align 8
// +
// + proc __src_main norecurse external ccc {
// + entry:
// +     store @a, i64 1, align 8
// +     copy @b <- @a, 8
// +     store @c, i64 1, align 8
// +     %0 = ptradd @c, 8
// +     store %0, i64 2, align 8
// +     %1 = ptradd @c, 16
// +     store %1, i64 3, align 8
// +     copy @d <- @c, 24
// +     ret
// + }

//L * ; ModuleID = 'test'
//L + source_filename = "test"
//L + target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
//L + target triple = "x86_64-unknown-linux"
//L +
//L + @_Sa = private global [8 x i8] undef, align 8
//L + @_Sb = private global [8 x i8] undef, align 8
//L + @_Sc = private global [24 x i8] undef, align 8
//L + @_Sd = private global [24 x i8] undef, align 8
//L +
//L + ; Function Attrs: noinline norecurse nounwind optnone uwtable
//L + define void @__src_main() #0 {
//L +   store i64 1, ptr @_Sa, align 8
//L +   call void @llvm.memcpy.p0.p0.i64(ptr @_Sb, ptr @_Sa, i64 8, i1 false)
//L +   store i64 1, ptr @_Sc, align 8
//L +   store i64 2, ptr getelementptr inbounds nuw (i8, ptr @_Sc, i64 8), align 8
//L +   store i64 3, ptr getelementptr inbounds nuw (i8, ptr @_Sc, i64 16), align 8
//L +   call void @llvm.memcpy.p0.p0.i64(ptr @_Sd, ptr @_Sc, i64 24, i1 false)
//L +   ret void
//L + }
//L +
//L + ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(argmem: readwrite)
//L + declare void @llvm.memcpy.p0.p0.i64(ptr noalias writeonly captures(none), ptr noalias readonly captures(none), i64, i1 immarg) #1
//L +
//L + attributes #0 = { noinline norecurse nounwind optnone uwtable "frame-pointer"="all" }
