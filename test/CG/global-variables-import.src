// V mkdir -p %t
// V %srcc test/inputs/global-variables.src --mo %t --target x86_64-unknown-linux
// R %srcc -fshort-filenames --ir %s -M %t --target x86_64-unknown-linux
// R[//L] %srcc -fshort-filenames --llvm %s -M %t --target x86_64-unknown-linux
program test;
import global_variables as m;

m::counter = m::fixed;
m::pair.x = m::values[1];
m::bump();
var empty: () = m::empty;

