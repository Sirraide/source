// R %srcc --ir --target x86_64-unknown-linux %s
program test;

var i: int;
var a: int^ = &i;
var b: int^^ = &a;

a = ^b;
^a = 4;
^^b = 5;
b = &^b;
b = ^&b;
a = &(if true then i else i);

