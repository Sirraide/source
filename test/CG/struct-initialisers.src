// R %srcc -fshort-filenames --ir --target x86_64-unknown-linux %s
program test;

struct Item {
    x: int;
    y: int;
    init (x: int, y: int) = ::(x + 1, y + 2);
    init = ::(10, 20);
}

struct Wrapper { item: Item; z: int; }
struct Factory { init (x: int) = x + 1; }

proc construct {
    var a = Item(1, 2);
    var b: Item = (3, 4);
    var raw: Item = ::(5, 6);
    var defaulted: Wrapper;
    var aggregate = Wrapper(Item::(7, 8), 9);
    var scalar = Factory(10);
}

proc tuple_default { var value: (Item, int); }

