// R %srcc -fshort-filenames --ir --target x86_64-unknown-linux %s
program test;

struct Item {
    int x;
    int y;
    init (int x, int y) = ::(x + 1, y + 2);
    init = ::(10, 20);
}

struct Wrapper { Item item; int z; }
struct Factory { init (int x) = x + 1; }

proc construct {
    var a = Item(1, 2);
    Item b = (3, 4);
    Item raw = ::(5, 6);
    Wrapper defaulted;
    var aggregate = Wrapper(Item::(7, 8), 9);
    var scalar = Factory(10);
}

proc tuple_default { (Item, int) value; }

