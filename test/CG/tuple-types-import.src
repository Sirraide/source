// V mkdir -p %t
// V %srcc test/inputs/tuple-types.src -I test/inputs --mo %t --target x86_64-unknown-linux
// R %srcc -fshort-filenames --ir %s -I test/inputs -M %t --target x86_64-unknown-linux
program test;
import tuple_types as m;
import <typedef.h> as c;

var nested = m::nested();
var local = (1, (2, 3));
#assert typeof(nested) == typeof(local);
assert nested[1][0] == 2;
var flat: (int, int, int) = m::nested();
assert flat[2] == 3;

var arg: (c::int_typedef, int) = (7 as c::int_typedef, 8);
var result = m::sugared(arg);
#assert typeof(result) == typeof(arg);
assert result[0] == 7;

var holder: m::Holder;
var tuple: (m::Element, int);
#assert typeof(holder.value) == typeof(tuple);
assert tuple[0].value == 42;

// * @nested = private 24, align 8
// + @local = private 24, align 8
// + @0 = "nested[1][0] == 2\00"
// + @1 = "tuple-types-import.src\00"
// + @flat = private 24, align 8
// + @2 = "flat[2] == 3\00"
// + @arg = private 16, align 8
// + @result = private 16, align 8
// + @3 = "result[0] == 7\00"
// + @holder = private 16, align 8
// + @tuple = private 16, align 8
// + @4 = "tuple[0].value == 42\00"
