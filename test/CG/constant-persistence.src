// R %srcc -fshort-filenames --ir --target x86_64-unknown-linux %s
program test;

struct Padded { first: i8; second: int; }
struct TailPadded { first: int; second: i8; }
struct Narrow { value: i9; }

proc padded = eval Padded(1, 2);
proc tail = eval TailPadded(3, 4);
proc narrow = eval Narrow(-1);
proc optional = eval int?(5);
proc absent = eval int?();
proc array = eval TailPadded[2](TailPadded(1, 2), TailPadded(3, 4));

