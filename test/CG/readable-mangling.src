// R %srcc --ir --target x86_64-unknown-linux %s
// R[//L] %srcc --llvm --target x86_64-unknown-linux %s
program readable;

proc keep (x: int) -> int = x;
proc unrelated (x: bool) -> bool = x;
proc keep (x: bool) -> bool = x;
proc constant ($n: int, x: int) -> int = x;
proc identity (x: $T) = x;
proc bound ($pair: (int, int), x: int) -> int = x;
proc quoted ($expression: tree) -> int = #inject(expression);
proc nested {
    { proc f (x: int) -> int = x; }
    proc middle {} // Does not consume an f suffix.
    { proc f (x: int) -> int = x; f(2); }
    { proc f (x: int) -> int = x; f(3); }
}
keep(1);
keep(true);
constant(42, 1);
constant(43, 1);
identity(1);
bound((1, 2), 1);
nested();
quoted(quote { 1 });
quoted(quote { 2 });

