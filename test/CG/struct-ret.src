program test;

struct x { a: int; }

proc b = x(1);
proc c(a: int) -> x {
    return x(a);
}

proc d -> x {
    var a = x(1);
    return a;
}

proc e -> x {
    var a = d();
    return (d());
}

proc f {
    d();
}

