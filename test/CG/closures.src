// R      %srcc --ir -foverflow-checks=false --target x86_64-unknown-linux %s
// R[//L] %srcc --llvm -foverflow-checks=false --target x86_64-unknown-linux %s
program test;

proc f1 -> int {
    var a: int = 20;
    var b: int = 2;
    proc g = a;
    proc h = 20;
    return g() + h() + 2;
}

proc f2 -> int {
    var a: int = 20;
    proc g -> int {
        var b: int = 30;
        proc h = a + b;
        return h();
    }
    return g();
}

proc f3 -> int {
    var a: int = 22;
    var b: int = 20;

    proc h(recurse: bool) -> int {
        return if recurse then g(false) else a;
    }

    proc g(recurse: bool) -> int {
        return if recurse then h(false) else b;
    }

    return h(true) + g(true);
}

proc f4 -> int {
    var a: int = 1;
    proc g1 = a;
    proc g2 -> int {
        var b: int = 2;
        proc g3 = a + b;
        proc g4 = g1() + g3() + a + b;
        return g1() + g3() + g4() + a;
    }
    return g1() + g2();
}

