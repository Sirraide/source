// V %srcc --cg --verify %s
program test;

proc f -> int {
    var y: int^ = eval { // expected-error: Constant value references out-of-scope stack memory
        var q: int = 42;
        &q;
    };

    ^(eval { // expected-error: Constant value references out-of-scope stack memory
        var q: int = 42;
        &q;
    }) = 42;

    return ^eval { // expected-error: Constant value references out-of-scope stack memory
        var q: int = 42;
        &q;
    };
}

proc g {
    // This is ok since the value is discarded and thus not emitted.
    eval {
        var q: int = 42;
        &q;
    }
}

proc h -> int[] {
    var s1: int[] = eval { // expected-error: Constant value references out-of-scope stack memory
        var i: int;
        int[](&i, 1);
    };

    var s2: int[] = eval { // expected-error: Constant value references out-of-scope stack memory
        var i: int;
        var j: int^ = &i;
        int[](j, 1);
    };

    // Ok since the value is unused.
    eval {
        var i: int;
        int[](&i, 1);
    };

    return eval { // expected-error: Constant value references out-of-scope stack memory
        var i: int;
        int[](&i, 1);
    };
}

proc x {}
proc foobar = true;

proc p1 {
    var s2 = eval x;
    s2();
}

proc p2 {
    (eval x)();
}

proc p3 {
    (eval if foobar() then p1 else p2)();
    (eval if foobar() then p2 else p1)();
}

proc p4 {
    var p = eval { // expected-error: Compile-time only procedure cannot be referenced at runtime
        proc foo {} // expected-note: Procedure declared here
        foo;
    };
}

proc p5 {
    var q1 = eval {
        proc bar {}
        (eval if foobar() then p1 else bar);
    };

    var q2 = eval { // expected-error: Compile-time only procedure cannot be referenced at runtime
        proc baz {} // expected-note: Procedure declared here
        (eval if foobar() then baz else p1);
    };
}

// Ensure that even if a procedure is first *instantiated* during
// constant evaluation, we don’t treat it as compile-time only if
// it is *declared* outside an eval.
proc p6 {
    proc t1 (t: $T) = t;
    var q1 = eval t1(42);
    var q2 = t1(42);
}

struct s {
    x: int;
    y: int^?;
}

proc p7 {
    var x = eval { // expected-error: Constant value references out-of-scope stack memory
        var i: int;
        s(i, &i);
    };
}

proc str {
    var x5 = eval __srcc_ptradd("1234".data, 5); // expected-error: Constant value contains a pointer whose target is unknown
    var x6 = eval __srcc_ptradd("1234".data, 10); // expected-error: Constant value contains a pointer whose target is unknown
}

// Captured closures follow the same rules as other evaluation-local pointers.
proc make_closure -> proc (int) -> int {
    var y = 1;
    proc increment (x: int) -> int = x + y;
    return increment;
}
proc captured_closures {
    var escaped = eval make_closure(); // expected-error: Constant value contains a closure with an environment
    var tuple = eval (make_closure(), 1); // expected-error: Constant value contains a closure with an environment
    var array = eval (make_closure(), make_closure()) as typeof(make_closure())[2]; // expected-error 2: Constant value contains a closure with an environment
    var record = eval Wrapper(make_closure()); // expected-error: Constant value contains a closure with an environment

    // Discarded values are not emitted.
    eval make_closure();
    eval (make_closure(), 1);
}
struct Wrapper { fn: proc (int) -> int; }
