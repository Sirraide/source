module lifecycle;
import <cxx-lifecycle.h> as cpp;
struct Outer { item: cpp::CxxObject; }
export proc make = cpp::CxxObject(42);
export proc make_outer -> Outer = ::(cpp::CxxObject(4),);
export proc take_outer (outer: Outer) {}
export proc take (object: cpp::CxxObject) {}
export proc borrow (in object: cpp::CxxObject) {}
export proc run {
    var object = cpp::CxxObject(42);
    var defaulted: cpp::CxxObject;
    var annotated = cpp::annotated_construct(value: 23);
    borrow(object);
    take(cpp::CxxObject());
    take_outer(Outer());
    var overloaded = cpp::CxxOverloaded(true);
    var input: i32;
    var referenced = cpp::CxxReference(&input);
    var trivial: cpp::CxxTrivial;
    var derived = cpp::CxxDerived(7);
    var hidden: cpp::CxxHidden;
    var outer: Outer;
    var aggregate: Outer = (cpp::CxxObject(2),);
    var array: cpp::CxxObject[2];
    var optional: cpp::CxxObject? = cpp::CxxObject(4);
}

