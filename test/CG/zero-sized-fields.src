// R %srcc --ir --target x86_64-unknown-linux %s
program test;

struct zero {}
struct s {
    a: zero;
    b: zero;
    c: zero;
}

proc a() extern -> zero;
proc b() extern -> zero;
proc c() extern -> zero;
proc d() extern -> s;

var e: s;
s(zero(), zero(), zero());

proc call {
    s(a(), b(), c());
    d();
}

