// R %srcc --ir -foverflow-checks=false --target x86_64-unknown-linux %s
program test;

proc a extern -> int;

proc d {
    loop { a(); }
}

proc e { loop a(); }
proc f { loop 4; }
proc g { loop; }
proc h = a() + loop;

var x = if 1 == 1 then 3 else loop;

