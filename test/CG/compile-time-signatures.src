// R %srcc -fshort-filenames --ir --target x86_64-unknown-linux %s
program test;

proc mixed ($t: type, first: t, $offset: int, second: t) = first + second + offset;
proc inferred ($value: $T) = value;
proc variadic ($tag: int) varargs = tag;
struct Item { value: int; init ($t: type, $offset: int, value: t) = ::(offset + value); }

proc caller (value: int) -> int {
    var first = mixed(int, value, 3, 4);
    var second = mixed(second: value, offset: 3, t: int, first: 4);
    var item: Item = (int, 5, value);
    return first + second + item.value + inferred(6) + variadic(7, value, 8);
}

// Compile-time-only inputs have no native ABI representation to check or emit.
proc native_empty ($ignored: void, value: int) native -> int = value;
proc native_caller (value: int) = native_empty({}, value);

