// R %srcc --ir --target x86_64-unknown-linux -foverflow-checks=false %s
program test;

struct Small {
    int x;
    delete { }
    copy = x;
};

proc sink(Small) {}
proc sink_int(int) {}

proc f1() {
    var s = Small(42);
    sink(copy s);
    sink(copy s);
    sink(copy Small(42));
    sink(s);
}

proc f2() {
    var s = Small(42);
    sink(copy s);
}

proc f3() {
    int x;
    sink_int(x);
    sink_int(copy x);
    sink_int(copy 42);
}

struct S {
    int x;
    int y;
    delete { }
    copy = (x * 2, y * 2);
}

proc f4() {
    S a = (4, 5);
    var b = copy a;
}

