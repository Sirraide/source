// +     store @a, i64 %4, align 8
// +     %5 = load i64, #1, align 8
// +     store @b, i64 %5, align 8
// +     %6 = call ccc zeroext i1 x()
// +     %7 = select %6, ptr @a, @b
// +     %8 = call ccc zeroext i1 x()
// +     %9 = select %8, ptr @b, @a
// +     %10 = load i64, %7, align 8
// +     store #2, i64 %10, align 8
// +     %11 = load i64, %9, align 8
// +     store %7, i64 %11, align 8
// +     %12 = load i64, #2, align 8
// +     store %9, i64 %12, align 8
// +     store @sa, ptr nil, align 8
// +     %13 = ptradd @sa, 8
// +     store %13, i64 0, align 8
// +     store @sb, ptr nil, align 8
// +     %14 = ptradd @sb, 8
// +     store %14, i64 0, align 8
// +     copy #3 <- @sa, 16
// +     copy @sa <- @sb, 16
// +     copy @sb <- #3, 16
// +     ret
// + }
// +
// + proc x external ccc -> i1 zeroext;

