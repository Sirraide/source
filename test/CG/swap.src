// R      %srcc --ir --target x86_64-unknown-linux %s
// R[//L] %srcc --llvm --target x86_64-unknown-linux %s
program test;

proc x extern -> bool;

var a: int;
var b: int;
a >< a;
a >< b;
(if x() then a else b) >< (if x() then b else a);

var sa: int[];
var sb: int[];
sa >< sb;

// * @a = private 8, align 8, init "\00\00\00\00\00\00\00\00"
