// R %srcc --ir --target x86_64-unknown-linux %s
program test;

proc a (a: void, b: void) {}
proc b { a(void(), void()); }
proc c { return void(); }

var e: void;
var f: void;
e = f;
f = e;
e;
e;

proc h = void();
proc i = h();
proc j { return h(); }

proc calls {
    var g: void = b();
    g = c();
    a(i(), j());
}

proc interleaved1 (in a: int, b: void, in c: int, d: void) = a | c;
proc interleaved2 (a: int, b: void, c: int, d: void) = a | c;
interleaved1(2, void(), 3, void());
interleaved2(2, void(), 3, void());

