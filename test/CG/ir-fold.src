// R %srcc --ir -foverflow-checks=false --target x86_64-unknown-linux %s
program test;

// Test that our IR builder performs trivial constant folding to simplify
// the life of our compile-time evaluator a bit.
var a = 4 - 3;
var b = 4 + 3;
var c: i64 = 7;

