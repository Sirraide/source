// R %srcc -fshort-filenames --ir --target x86_64-unknown-linux %s -I test/inputs
program test;
import <constant-padding.h> as c;

proc bytes = eval c::ConstantBytes();
proc padding = eval c::ConstantPadding();
proc bitfield = eval c::ConstantBits();
proc union_ = eval c::ConstantUnion();

