// R %srcc --ir --target x86_64-unknown-linux %s
program test;

struct s {
    x: int;
}

proc q() = s(42);
proc sink(int) extern;

var a: s = (1);
with a { x = 4; }
sink(a.x);

with s(2) {
    sink(x);
    x = 3;
    sink(x);
}

with q() {
    sink(x);
}

