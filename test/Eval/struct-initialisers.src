// V %srcc --eval %s
program test;

var defaults = 0;
struct Pair {
    x: int;
    y: int;
    init (x: int, y: int) = ::(x + 1, y + 2);
    init { defaults += 1; return ::(10, 20); }
}

var a: Pair = (1, 2);
assert a.x == 2;
assert a.y == 4;

var b = Pair(y: 3, x: 4);
assert b.x == 5;
assert b.y == 5;

var c: Pair;
assert c.x == 10;
assert defaults == 1;

var raw: Pair = Pair::(6, 7);
assert raw.x == 6;
assert raw.y == 7;

var raw_default: Pair = ::();
assert raw_default.x == 0;
assert defaults == 1;

var copied: Pair = a;
assert copied.x == 2;
assert defaults == 1;

var explicit_copy = Pair(a);
assert explicit_copy.y == 4;

struct Sum {
    ignored: int;
    init (x: int, y: int) = x + y;
}

assert Sum(3, 4) == 7;
var sum = Sum(5, 6);
assert sum == 11;

struct Nested {
    pair: Pair;
    z: int;
}

var nested: Nested;
assert defaults == 2;
assert nested.pair.y == 20;

var aggregate = Nested(Pair::(30, 40), 50);
assert defaults == 2;
assert aggregate.pair.x == 30;
assert aggregate.z == 50;

var named = Nested(z: 60, pair: Pair::(70, 80));
assert named.pair.y == 80;
assert defaults == 2;

var raw_nested: Nested = ::((), 90);
assert raw_nested.pair.x == 10;
assert defaults == 3;

var array: Pair[2];
assert defaults == 5;
assert array[1].y == 20;

struct ArrayField { pairs: Pair[2]; }
var array_field: ArrayField;
assert defaults == 7;
assert array_field.pairs[0].x == 10;

struct NoDefault {
    x: int;
    init (x: int) = ::(x,);
}

struct CannotDefault { value: NoDefault; x: int; }
var full = CannotDefault(NoDefault(12), 13);
assert full.value.x == 12;

struct Override {
    pair: Pair;
    init = ::(Pair::(100, 200),);
}

var override: Override;
assert defaults == 7;
assert override.pair.x == 100;

struct Explicit {
    x: int;
    init (x: int) -> This { return ::(x,); }
}

assert Explicit(99).x == 99;

struct Choice {
    x: int;
    init (x: int) = ::(x + 1,);
    init (x: int, y: int) = ::(x + y,);
}

assert Choice(3).x == 4;
assert Choice(y: 5, x: 4).x == 9;

struct ScalarDefault { init = 42; }
assert ScalarDefault() == 42;

var tuple_default: (Pair, int);
assert defaults == 8;
assert tuple_default[0].x == 10;

var deleted = 0;
struct Token {
    id: int;
    init (id: int) = ::(id,);
    init = ::(10,);
    delete { deleted += 1; }
}

struct Holder { token: Token; x: int; }

{
    var holder: Holder;
    assert holder.token.id == 10;
}
assert deleted == 1;

{
    var holder = Holder(Token(12), 20);
    assert holder.token.id == 12;
}
assert deleted == 2;

proc local -> int {
    struct Local {
        x: int;
        init (x: int, offset: int) = ::(x + offset,);
    }
    return Local(2, 100).x;
}
assert local() == 102;

proc accept (p: Pair) -> int = p.x + p.y;
assert accept((1, 2)) == 6;
var optional: Pair? = Pair(3, 4);
assert optional != nil;

struct DefaultFactory { x: int; init = 123; }
struct FactoryField { field: DefaultFactory; x: int; }

var factory_field = FactoryField(DefaultFactory::(99,), 100);
assert factory_field.field.x == 99;

proc factory_field_value (value: FactoryField) -> int = value.field.x;
assert factory_field_value(factory_field) == 99;

struct Variadic {
    x: int;
    init (xs: int...) = ::(xs[0],);
}

assert Variadic(21, 22).x == 21;

struct TupleFactory {
    init (x: int) = (int, int)::(x, x + 1);
}

var tuple_factory = TupleFactory(23);
assert tuple_factory[0] == 23;
assert tuple_factory[1] == 24;

proc Pair::total (in this) -> int = this.x + this.y;
var pair_pointer = &a;
assert pair_pointer.total() == 6;
