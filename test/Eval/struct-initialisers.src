// V %srcc --eval %s
program test;

var defaults = 0;
struct Pair {
    int x;
    int y;
    init (int x, int y) = ::(x + 1, y + 2);
    init { defaults += 1; return ::(10, 20); }
}

Pair a = (1, 2);
assert a.x == 2;
assert a.y == 4;

var b = Pair(y: 3, x: 4);
assert b.x == 5;
assert b.y == 5;

Pair c;
assert c.x == 10;
assert defaults == 1;

Pair raw = Pair::(6, 7);
assert raw.x == 6;
assert raw.y == 7;

Pair raw_default = ::();
assert raw_default.x == 0;
assert defaults == 1;

Pair copied = a;
assert copied.x == 2;
assert defaults == 1;

var explicit_copy = Pair(a);
assert explicit_copy.y == 4;

struct Sum {
    int ignored;
    init (int x, int y) = x + y;
}

assert Sum(3, 4) == 7;
var sum = Sum(5, 6);
assert sum == 11;

struct Nested {
    Pair pair;
    int z;
}

Nested nested;
assert defaults == 2;
assert nested.pair.y == 20;

var aggregate = Nested(Pair::(30, 40), 50);
assert defaults == 2;
assert aggregate.pair.x == 30;
assert aggregate.z == 50;

var named = Nested(z: 60, pair: Pair::(70, 80));
assert named.pair.y == 80;
assert defaults == 2;

Nested raw_nested = ::((), 90);
assert raw_nested.pair.x == 10;
assert defaults == 3;

Pair[2] array;
assert defaults == 5;
assert array[1].y == 20;

struct ArrayField { Pair[2] pairs; }
ArrayField array_field;
assert defaults == 7;
assert array_field.pairs[0].x == 10;

struct NoDefault {
    int x;
    init (int x) = ::(x,);
}

struct CannotDefault { NoDefault value; int x; }
var full = CannotDefault(NoDefault(12), 13);
assert full.value.x == 12;

struct Override {
    Pair pair;
    init = ::(Pair::(100, 200),);
}

Override override;
assert defaults == 7;
assert override.pair.x == 100;

struct Explicit {
    int x;
    init (int x) -> This { return ::(x,); }
}

assert Explicit(99).x == 99;

struct Choice {
    int x;
    init (int x) = ::(x + 1,);
    init (int x, int y) = ::(x + y,);
}

assert Choice(3).x == 4;
assert Choice(y: 5, x: 4).x == 9;

struct ScalarDefault { init = 42; }
assert ScalarDefault() == 42;

(Pair, int) tuple_default;
assert defaults == 8;
assert tuple_default[0].x == 10;

var deleted = 0;
struct Token {
    int id;
    init (int id) = ::(id,);
    init = ::(10,);
    delete { deleted += 1; }
}

struct Holder { Token token; int x; }

{
    Holder holder;
    assert holder.token.id == 10;
}
assert deleted == 1;

{
    var holder = Holder(Token(12), 20);
    assert holder.token.id == 12;
}
assert deleted == 2;

proc local -> int {
    struct Local {
        int x;
        init (int x, int offset) = ::(x + offset,);
    }
    return Local(2, 100).x;
}
assert local() == 102;

proc accept (Pair p) -> int = p.x + p.y;
assert accept((1, 2)) == 6;
Pair? optional = Pair(3, 4);
assert optional != nil;

struct DefaultFactory { int x; init = 123; }
struct FactoryField { DefaultFactory field; int x; }

var factory_field = FactoryField(DefaultFactory::(99,), 100);
assert factory_field.field.x == 99;

proc factory_field_value (FactoryField value) -> int = value.field.x;
assert factory_field_value(factory_field) == 99;

struct Variadic {
    int x;
    init (int... xs) = ::(xs[0],);
}

assert Variadic(21, 22).x == 21;

struct TupleFactory {
    init (int x) = (int, int)::(x, x + 1);
}

var tuple_factory = TupleFactory(23);
assert tuple_factory[0] == 23;
assert tuple_factory[1] == 24;

proc Pair::total (in this) -> int = this.x + this.y;
var pair_pointer = &a;
assert pair_pointer.total() == 6;
