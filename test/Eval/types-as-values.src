// V %srcc --sema --verify %s
program test;

#assert int == int;
#assert int != int^;

#assert int != int; // expected-error: Assertion failed: 'int != int'
#assert int == int^; // expected-error: Assertion failed: 'int == int^'

eval {
    var a: type = int;
    var b: type = int;
    assert a == b;
}