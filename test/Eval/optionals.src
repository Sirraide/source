// V %srcc --sema --verify %s
program test;

proc p1 -> int {
    var i: int;
    var pi: int^?;
    pi = &i;
    ^pi = 42;
    return i;
}

#assert p1() == 42;

proc p2 -> int {
    var i: int;
    var pi: int^?;
    ^pi = 42; // expected-error: Optional might be nil when accessed here
    return i;
}

// Failed IR finalisation is cached and diagnosed only once.
#assert p2() == 42;
#assert p2() == 42;

proc p3 -> int {
    var i: int;
    var p1: int^? = &i;
    var p2: int^? = p1;
    ^p2 = 42;
    return i;
}

#assert p3() == 42;

proc p4 (x: int?) = match x {
    nil: 5;
    42: 7;
    _: x;
};

#assert p4(nil) == 5;
#assert p4(42) == 7;
#assert p4(9) == 9;