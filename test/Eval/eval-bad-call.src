// V %srcc --sema --verify %s
program test;

proc f() { // expected-note: While translating body of 'f'
    eval f(); // expected-error: Cyclic semantic dependency

    // A later body is compiled on demand.
    eval g();
}

proc g() {

}

proc invalid_ret() -> qefqefeqf {} // expected-error: Unknown symbol 'qefqefeqf'
#assert invalid_ret() == 4; // expected-error: Invalid operation: '==' between 'void' and 'int'

proc invalid_param(afadfeadf) {} // expected-error: Unknown symbol 'afadfeadf'
#assert invalid_param() == 4;

proc contains_error() -> int = "1234"; // expected-error: Cannot convert expression of type 'i8 val[]' to 'int'
#assert contains_error() == 4;
