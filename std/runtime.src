module __src_runtime;

import <cstdlib>, <cstdio> as libc;

/// Helpers to format assertion messages.
///
/// The layout and name of this type are hard-coded into the compiler.
/// DO NOT MODIFY!
export struct __src_assert_msg_buf {
    data: i8^;
    size: int;
    capacity: int;
}

/// Payload passed to various assertion handlers.
///
/// The layout of this type is hard-coded into the compiler.
/// DO NOT MODIFY!
export struct AbortInfo {
    filename: i8 val[];
    line: int;
    col: int;
    msg1: i8 val[];
    msg2: i8 val[];

    // FIXME: This can be null! DO NOT USE outside the constant evaluator
    // until we have optionals.
    stringifier: proc (inout __src_assert_msg_buf);
}

/// Program entry point generated by the compiler.
proc __src_main extern;

/// Print the location at which an error occurred.
proc print_file (in info: AbortInfo) {
    var filename = info.filename;
    if filename.size == 0 then filename = "<invalid filename>";

    // FIXME: Using printf might be a problem if this is called from inside a
    // signal handler; switch to using write() instead on linux (the same applies
    // to some of the other printf() calls below).
    libc::printf(
        "Fatal Error at %.*s:%zu:%zu\n".data,
        filename.size as __srcc_ffi_int,
        filename.data,
        info.line,
        info.col
    );
}

/// Arithmetic failure handler.
///
/// The __src_abort_info type passed to these handlers does not
/// need to be exported by this because it’s part of the preamble,
/// so it should always be available.
export proc __src_int_arith_error (info: AbortInfo val^) native -> noreturn {
    print_file(^info);
    libc::printf(
        "    %.*s while evaluating '%.*s'\n".data,
        info.msg2.size as __srcc_ffi_int,
        info.msg2.data,
        info.msg1.size as __srcc_ffi_int,
        info.msg1.data,
    );
    libc::abort();
}

/// Assertion handler.
export proc __src_assert_fail (info: AbortInfo val^) native -> noreturn {
    print_file(^info);
    libc::printf(
        "    assertion '%.*s' failed".data,
        info.msg1.size as __srcc_ffi_int,
        info.msg1.data,
    );

    if info.msg2.size != 0 then libc::printf(
        ": %.*s".data,
        info.msg2.size as __srcc_ffi_int,
        info.msg2.data,
    );

    libc::putchar("\n"[0]);
    libc::abort();
}

export proc __src_assert_append_int (inout into: __src_assert_msg_buf, value: int) nomangle {
    // 0 is a special case.
    if value == 0 then {
        __src_assert_append_str(into, '0');
        return;
    }

    // For everything else, we need a tempoary buffer.
    var tmp: i8[int.bits];
    var bits_used: int = 0;

    // Remember whether this was negative.
    var negative: bool = value < 0;
    if negative then value = -value;

    // Append the digits.
    while value != 0 {
        tmp[bits_used] = (value % 10) as i8 + '0'[0];
        value /= 10;
        bits_used++;
    }

    // If the value was negative, add a minus sign.
    if negative then __src_assert_append_str(into, '-');

    // Reverse the digits.
    for i in 0..<bits_used/2 {
        var j: int = bits_used - i - 1;
        tmp[i] >< tmp[j];
    }

    // And append them.
    __src_assert_append_str(into, (&tmp, bits_used));
}

export proc __src_assert_append_str (inout into: __src_assert_msg_buf, str: i8 val[]) nomangle {
    if into.size + str.size >= into.capacity return;
    __srcc_memcpy(__srcc_ptradd(into.data, into.size), str.data, str.size);
    into.size += str.size;
}

export proc __src_assert_alloc_buffer nomangle -> __src_assert_msg_buf {
    var mem = libc::malloc(10000);

    // Can’t use 'assert' here since this is used to implement 'assert'...
    if mem == nil {
        libc::printf("__src_assert_alloc_buffer: fatal error: malloc() failed");
        libc::abort();
    }

    return (mem as! i8^, 0, 10000);
}

/// Declare our own initialiser so we can call it.
///
/// Unlike other modules, the runtime is not initialised when it is
/// imported (this is mostly an optimisation to avoid having to call
/// its initialiser in *every* module, and also because we might not
/// have a runtime); this means that we need to initialise ourselves.
proc \(__src_static_init.__src_runtime) extern;

/// Entry point called by the C runtime.
export proc __src_runtime_entry(
    argc: __srcc_ffi_int,
    argv: __srcc_ffi_char^^,
) native {
    \(__src_static_init.__src_runtime)();
    __src_main();
}
